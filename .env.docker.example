# Copy this file to .env.docker before running Docker Compose.
# Default mode: Docker Compose runs both web and MySQL db containers.
# If you want Docker web to use your Mac local MySQL instead, set:
# DB_HOST=host.docker.internal
# DB_USER=root
# DB_PASSWORD=your_local_mysql_password

SECRET_KEY=django-insecure-nufi-docker-local-change-before-production
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost,0.0.0.0,web
TUNNEL_ALLOWED_HOSTS=.trycloudflare.com
WEB_HOST_PORT=8001
PORT=8000
WEB_CONCURRENCY=2
GUNICORN_TIMEOUT=120
RUN_MIGRATIONS=true
RUN_COLLECTSTATIC=true

DB_ENGINE=mysql
DB_NAME=pfms
DB_USER=nufi
DB_PASSWORD=nufi_password
DB_HOST=db
DB_PORT=3306
DB_UNIX_SOCKET=

MYSQL_DATABASE=pfms
MYSQL_USER=nufi
MYSQL_PASSWORD=nufi_password
MYSQL_ROOT_PASSWORD=root_password
MYSQL_HOST_PORT=3308

GS_BUCKET_NAME=
REPORT_OUTPUT_DIR=generated_reports

DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=admin@nufi.local
DJANGO_SUPERUSER_PASSWORD=admin12345

GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
